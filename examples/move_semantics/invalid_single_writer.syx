// xpass: single-writer/move model is not enforced yet: `&mut p2` after a
// move-like binding (`let mut p2 = p`) currently compiles, but the comments
// below expect an error. This documents the gap.
object Person {
    age: int
}
func main(): void{
    let mut p = Person(age:0);
    let mut p2 = p; //should move

    let pref = &mut p2; //error, p was moved
    pref.age = 12;

}
