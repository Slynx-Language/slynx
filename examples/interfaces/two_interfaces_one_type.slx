// A single type with two interfaces compiles; each interface's methods
// resolve through their own `extend` block.
interface Stringifiable {
    func stringify(&self) -> str
}

interface Formattable {
    func to_json(&self) -> str
}

object Person {
    name: str
}

extend Person: Stringifiable {
    func stringify(&self) -> str { self.name }
}

extend Person: Formattable {
    func to_json(&self) -> str { self.name }
}

func main(): void {
    let person = Person(name: "ada");
    person.stringify();
    person.to_json();
}